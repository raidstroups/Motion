{
  "name": "motion-studio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "db:generate": "npm run db:generate --workspace=@motion/database",
    "db:push": "npm run db:push --workspace=@motion/database",
    "db:migrate": "npm run db:migrate --workspace=@motion/database",
    "db:studio": "npm run db:studio --workspace=@motion/database"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "npm@10.9.0"
}
