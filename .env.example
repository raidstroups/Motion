# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/motion_studio

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis
REDIS_URL=redis://localhost:6379

# OpenAI (for AI agents)
OPENAI_API_KEY=sk-your-openai-key

# Storage
STORAGE_BUCKET=motion-assets
STORAGE_URL=https://your-project.supabase.co/storage/v1

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Upload
UPLOAD_DIR=/tmp/motion-uploads

# Workers
VIDEO_WORKER_URL=http://localhost:3001
AUDIO_WORKER_URL=http://localhost:3002
VFX_WORKER_URL=http://localhost:3003
RENDER_WORKER_URL=http://localhost:3004
